# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# / was on /dev/nvme0n1p2 during curtin installation
/dev/disk/by-uuid/f4b4af0a-acb8-4b97-a7c7-5e6a96f5a56d / ext4 defaults 0 1
# /boot/efi was on /dev/nvme0n1p1 during curtin installation
/dev/disk/by-uuid/9784-2D67 /boot/efi vfat defaults 0 1
/swap.img	none	swap	sw	0	0
UUID=a3348639-452d-4ba6-b8c4-3db1c403cafb /mnt/internal ext4 defaults 0 2
192.168.0.23:/volume1/media /mnt/nas nfs defaults,_netdev,nofail,bg,hard,timeo=600,retrans=5,x-systemd.after=network-online.target,x-systemd.mount-timeout=90 0 0
/mnt/internal:/mnt/nas /mnt/media fuse.mergerfs defaults,allow_other,use_ino,category.create=mfs,nonempty,_netdev,nofail,x-systemd.after=mnt-nas.mount,cache.files=off 0 0
