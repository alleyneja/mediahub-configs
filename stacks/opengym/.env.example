# openGym configuration.
#
# WEB_PORT is read by compose's ${WEB_PORT} interpolation, which is fed by THIS
# file only because it is literally named `.env` in the stack directory.
# `env_file:` does NOT feed interpolation — see docs/compose-env-interpolation.md.

# --- Passkey binding (ONE-WAY: changing either invalidates every passkey) -------
# Must be the exact hostname the browser sees. Served by Caddy with `tls internal`;
# this works ONLY because the devices that use it already trust the Caddy root CA.
# A device that does not gets a click-through cert warning and then a passkey prompt
# that silently never appears.
#
# RP_ID IS EFFECTIVELY PERMANENT: there is no endpoint to add a passkey to an existing
# account, so changing it forces everyone into new accounts and abandons their history.
# ORIGIN is only checked at assertion time and can change freely.
# See docs/opengym-gym-lan-passkeys.md.
RP_ID=gym.lan
ORIGIN=https://gym.lan
RP_NAME=openGym

# --- Ports ---------------------------------------------------------------------
WEB_PORT=8085

# --- Sessions ------------------------------------------------------------------
# Only affects cookies minted from now on; lowering it never cuts an existing
# session short. Revoke one account's sessions with POST /api/logout/all.
SESSION_DAYS=90

# --- Access control ------------------------------------------------------------
# Leave both empty for the first boot. Register your own profile, read your id
# from /srv/docker/opengym/data/db.json (users[].id), then set ADMIN_UIDS to it
# and set INVITE_ONLY=1 before inviting anyone else.
ADMIN_UIDS=
INVITE_ONLY=
