+def _note_download_result(ok, error_text=""):
+    """Circuit breaker. A success resets the streak; only "not a bot" failures
+    extend it (other failures, such as a deleted video, neither count nor reset)."""
+    global _bot_block_streak
+    with _bot_block_lock:
+        if ok:
+            _bot_block_streak = 0
+            return False
+        if "not a bot" not in (error_text or "").lower():
+            return False
+        _bot_block_streak += 1
+        trip = _bot_block_streak >= _BOT_BLOCK_LIMIT
+        if trip:
+            _bot_block_streak = 0
+    if trip:
+        _trip_bot_block_breaker()
+    return trip
+
+
+def _probe_duration_seconds(path):
+    """Real length of a downloaded file in seconds (0.0 if it cannot be read)."""
+    try:
+        out = subprocess.run(
+            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
+             "-of", "default=nw=1:nk=1", path],
+            capture_output=True, text=True, timeout=60,
+        )
+        return float(out.stdout.strip())
+    except (OSError, ValueError, subprocess.SubprocessError):
+        return 0.0
+
+
+def _is_live_stream(url):
+    """True if the URL is a live stream (never finishes downloading).
+
+    Metadata-only lookup. Fails open: any error returns False so the normal
+    download path (and its own error handling) still runs.
+    """
+    try:
+        import yt_dlp
+        opts = {
+            **_build_common_opts(),
+            "skip_download": True,
+            "ignore_no_formats_error": True,
+            "extract_flat": False,
+        }
+        opts.pop("format_sort", None)
+        with yt_dlp.YoutubeDL(opts) as ydl:
+            info = ydl.extract_info(url, download=False, process=False) or {}
+        return bool(info.get("is_live")) or info.get("live_status") in (
+            "is_live", "is_upcoming",
+        )
+    except Exception:
+        return False
+
+
+def _too_short(real_sec, expected_sec, listed_sec, tolerance):
+    """Reason a downloaded file is too short, or "" if it is acceptable.
+
+    Search results and album playlists only carry a *listed* length; the stream
+    actually served can be a shorter cut or a truncated download, and nothing
+    else measures the file. Only shortness is judged here: a longer file may be a
+    legitimate alternate edition, and AcoustID covers wrong songs.
+    """
+    if real_sec <= 0:
+        return ""
+    if expected_sec > 0 and real_sec < expected_sec - tolerance:
+        return (f"file is {real_sec:.0f}s, shorter than the expected"
+                f" {expected_sec:.0f}s")
+    if listed_sec and real_sec < listed_sec - tolerance:
+        return (f"file is {real_sec:.0f}s but the source was listed at"
+                f" {listed_sec:.0f}s (truncated or shorter cut)")
+    return ""
+
+
+SHORT_FALLBACK_FRACTION = 0.25  # keep a short/alternate cut only within 25% of the expected length
+
+
+def _norm_title(text):
+    text = unicodedata.normalize("NFKD", text or "").encode("ascii", "ignore").decode()
+    return re.sub(r"[^a-z0-9]+", " ", text.lower()).strip()
+
+
+def _same_song(track_title, matched_title, artist, candidate):
+    """AcoustID heard a different MusicBrainz recording; is it still this song?
+
+    Same title, and the artist shows in the upload's title or channel (AcoustID
+    results carry no artist here). A cover or namesake by someone else fails the
+    artist cue; a different title always fails.
+    """
+    want = _norm_title(track_title)
+    if not want or want != _norm_title(matched_title):
+        return False
+    artist = _norm_title(artist)
+    hay = _norm_title(f"{candidate.get('title', '')} {candidate.get('channel', '')}")
+    return bool(artist) and artist in hay
+
