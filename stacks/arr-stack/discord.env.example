# notify-audio-mismatch.sh reads this file at /config/discord.env inside
# the sonarr/radarr containers (bind-mounted, read-only, by
# docker-compose.yml). It is NOT compose-interpolated -- it's a real file
# on disk, not a ${VAR}.
#
# Copy to `discord.env` in this directory and fill in a real value.
# `discord.env` is gitignored (matches the repo-wide *.env rule).
#
# Reuses the same webhook Uptime Kuma already posts to -- see Kuma's
# Settings > Notifications > Discord for the live URL if this needs
# rotating.

DISCORD_WEBHOOK_URL=
