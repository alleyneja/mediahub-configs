# Front door for mediahub-r9 (docs/fleet-architecture.md, D6). Serves r9's own services by container name on r9_internal.
# Certificates come from r9's OWN name-constrained intermediate (key generated on r9, signed once on production;
# valid to 2027-09-21, RENEW by 2027-09-01, see ~/mediahub-cleanup.md and D6).
{
	admin off
	auto_https disable_redirects
	pki {
		ca local {
			root {
				cert /pki/root.crt
			}
			intermediate {
				cert /pki/intermediate.crt
				key /pki/intermediate.key
			}
		}
	}
}

stirling.lan {
	tls internal
	log
	reverse_proxy stirling-pdf:8080
}
