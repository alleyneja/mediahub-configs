# gluetun -- required environment
#
# Copy to `.env` in this directory and fill in real values.
#
# WHY THIS FILE MATTERS: docker compose interpolates ${VAR} from a `.env` file in
# the project directory (or the shell). It does NOT read `env_file:` for that --
# `env_file:` only populates the container's environment. So a missing `.env` does
# not fail: every ${VAR} silently becomes an empty string and the stack comes up
# misconfigured. Never delete `.env` assuming `env_file:` covers it.
#
# `.env` is gitignored. This example file is the only record of what is required.

# NordVPN access token from the NordVPN dashboard
NORDVPN_ACCESS_TOKEN=

# WireGuard private key. 44 chars of base64 that ENDS IN '=' -- keep the padding.
# Gluetun will NOT derive this from NORDVPN_ACCESS_TOKEN; it must be set
# explicitly, or the container fails its healthcheck with "private key is not
# set" and qbittorrent never starts (it depends on gluetun being healthy).
#
# TO RECOVER IT, given a valid NORDVPN_ACCESS_TOKEN:
#   curl -u "token:$NORDVPN_ACCESS_TOKEN" \
#     https://api.nordvpn.com/v1/users/services/credentials
# and read .nordlynx_private_key from the JSON. A 401 there means the token is
# stale -- generating a new token in the NordVPN dashboard supersedes the old
# one, so a token baked into an old container may already be revoked.
#
# Write it with python/printf, NOT sed: base64 contains '/' and '+'.
WIREGUARD_PRIVATE_KEY=

