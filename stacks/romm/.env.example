# romm -- required environment
#
# Copy to `.env` in this directory and fill in real values.
#
# WHY THIS FILE MATTERS: docker compose interpolates ${VAR} from a `.env` file in
# the project directory (or the shell). It does NOT read `env_file:` for that --
# `env_file:` only populates the container's environment. So a missing `.env` does
# not fail: every ${VAR} silently becomes an empty string and the stack comes up
# misconfigured. Never delete `.env` assuming `env_file:` covers it.
#
# `.env` is gitignored. This example file is the only record of what is required.

# WARNING: this stack's volumes are pinned to the Portainer project prefix (33_)
# in docker-compose.yml. Do not 'clean that up' -- see the comment there.

# MariaDB app-user password. Recover: docker inspect romm | grep DB_PASSWD
ROMM_DB_PASSWORD=

# MariaDB root password. Recover: docker inspect romm-db
ROMM_MYSQL_ROOT_PASSWORD=

# Session signing key
ROMM_AUTH_SECRET_KEY=

# IGDB API credentials from https://api-docs.igdb.com
IGDB_CLIENT_ID=

# IGDB API credentials
IGDB_CLIENT_SECRET=

# Must match the value in stacks/authentik
ROMM_OIDC_CLIENT_ID=

# Must match the value in stacks/authentik
ROMM_OIDC_CLIENT_SECRET=

