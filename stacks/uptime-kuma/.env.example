# uptime-kuma -- required environment
#
# Copy to `.env` in this directory and fill in real values.
#
# WHY THIS FILE MATTERS: docker compose interpolates ${VAR} from a `.env` file in
# the project directory (or the shell). It does NOT read `env_file:` for that --
# `env_file:` only populates the container's environment. So a missing `.env` does
# not fail: every ${VAR} silently becomes an empty string and the stack comes up
# misconfigured. Never delete `.env` assuming `env_file:` covers it.
#
# `.env` is gitignored. This example file is the only record of what is required.

# Host LAN address used for port binding
SERVER_IP=

# Tailnet IP of this host
TAILSCALE_IP=

# Full MagicDNS name, e.g. host.tailXXXX.ts.net
TAILSCALE_HOSTNAME=


# --- Homepage widget credentials ---
# Portainer's copy of this stack had these HARDCODED in the compose file. This
# repo is public, so they are parameterised and the real values live in .env.
# Recover any of them from the running container:
#   docker inspect homepage | grep HOMEPAGE_VAR_<NAME>
# or from the source app's own settings (Settings > General > API Key in the
# *arr apps). WARNING: if these are missing, every Homepage widget renders
# BLANK -- the tiles still appear, they just show no data. Easy to miss.

HOMEPAGE_VAR_ADGUARD_HOME_USERNAME=
HOMEPAGE_VAR_ADGUARD_HOME_PASSWORD=
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_LIDARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=
HOMEPAGE_VAR_SABNZBD_KEY=
HOMEPAGE_VAR_SEERR_KEY=
HOMEPAGE_VAR_IMMICH_KEY=
HOMEPAGE_VAR_MEALIE_KEY=
HOMEPAGE_VAR_EBOOKS_BOOKSHELF_KEY=
HOMEPAGE_VAR_AUDIOBOOKS_BOOKSHELF_KEY=
