# ─────────────────────────────────────────
# PTERODACTYL SERVERS (MINECRAFT)
# ─────────────────────────────────────────

pterodactyl.lan {
    tls internal
    root * /var/www/pterodactyl/public
    php_fastcgi unix//run/php/pterodactyl.sock
    file_server
    encode gzip
}

pterodactyl.lan:8090 {
    tls internal
    reverse_proxy 192.168.0.21:8090 {
        header_up Connection {>Connection}
        header_up Upgrade {>Upgrade}
    }
}

# ─────────────────────────────────────────
# UTILITIES
# ─────────────────────────────────────────

stirling.lan {
    tls internal
    # Temporary: diagnosing a white screen on iOS Safari over cellular.
    # Caddy logs only errors by default, so successful/partial transfers were
    # invisible. Remove once the remote-load issue is settled.
    log {
        output stdout
        format json
    }
    reverse_proxy stirling-pdf:8080
}
