# ─────────────────────────────────────────
# PTERODACTYL SERVERS (MINECRAFT)
# ─────────────────────────────────────────

pterodactyl.lan {
    tls internal
    root * /var/www/pterodactyl/public
    php_fastcgi unix//run/php/pterodactyl.sock
    file_server
    encode gzip
}

pterodactyl.lan:8090 {
    tls internal
    reverse_proxy 192.168.0.21:8090 {
        header_up Connection {>Connection}
        header_up Upgrade {>Upgrade}
    }
}
