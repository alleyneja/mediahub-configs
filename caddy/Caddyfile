# ─────────────────────────────────────────
# PERSONAL CLOUD
# ─────────────────────────────────────────

vaultwarden.lan {
    tls internal
    reverse_proxy vaultwarden:80
}

auth.lan {
    tls internal
    reverse_proxy authentik-server:9000
}

nextcloud.lan {
    tls internal
    reverse_proxy nextcloud:80
}

immich.lan {
    tls internal
    reverse_proxy immich-server:2283
}

# CouchDB backend for Obsidian Self-hosted LiveSync.
# Do NOT add Authentik forward-auth here — LiveSync uses HTTP basic auth and
# cannot complete an interactive login flow. Forward-auth silently breaks sync.
obsidian-sync.lan {
    tls internal
    reverse_proxy couchdb:5984
}

# ─────────────────────────────────────────
# BOOKS & READING
# ─────────────────────────────────────────

calibre-web.lan {
    tls internal
    reverse_proxy calibre-web-automated:8083 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
    }
}

