# Boot-time mount guard for r9 (scripts/media-mounts-ensure.sh): retries the NAS/media mounts for up to 20 min and
# keeps Plex stopped until they exist. Runs before fleet-healthcheck so the health check sees the settled state.
# SCRIPT_PATH is substituted at install time (r9: /home/jay/mediahub-configs/scripts/media-mounts-ensure.sh).
[Unit]
Description=Ensure NAS and media mounts at boot; hold Plex until they exist
Wants=network-online.target
After=network-online.target docker.service
Before=fleet-healthcheck.service

[Service]
Type=oneshot
ExecStart=SCRIPT_PATH
TimeoutStartSec=1400

[Install]
WantedBy=multi-user.target
