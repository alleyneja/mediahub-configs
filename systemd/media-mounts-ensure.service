# Mount guard (scripts/media-mounts-ensure.sh), r9 and production: after boot, if the NAS/media mounts are missing it
# stops the containers that bind them, retries the mounts until they are real, then starts those containers.
# Type=simple on purpose: it may wait indefinitely and must not block boot or fleet-healthcheck.
# SCRIPT_PATH is substituted at install time (/home/jay/mediahub-configs/scripts/media-mounts-ensure.sh).
[Unit]
Description=Ensure NAS and media mounts; hold dependent containers until they exist
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
ExecStart=SCRIPT_PATH
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
