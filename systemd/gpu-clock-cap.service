[Unit]
Description=Cap NVIDIA GPU max clock (keeps r9 under the BE600M1 UPS limit)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-smi -lgc 210,1500
ExecStop=/usr/bin/nvidia-smi -rgc

[Install]
WantedBy=multi-user.target
