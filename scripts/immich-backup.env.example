# Copy to immich-backup.env (gitignored, chmod 600) and paste the Push URL of the Uptime Kuma monitor "Immich nightly backup".
# The URL must keep the query string exactly as shown so the script can switch it to status=down on failure.
KUMA_PUSH_URL="http://localhost:3003/api/push/<token>?status=up&msg=OK&ping="
