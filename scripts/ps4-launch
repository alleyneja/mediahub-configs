#!/usr/bin/env bash
# Launch shadPS4 for ES-DE and quit it from the pad: hold the Xbox (Guide) button ~1s, or double-tap it.
# ES-DE ROMs for the ps4 system are small text files ("Dark Souls Remastered.ps4") whose first line is the
# game serial; the game itself is the unpacked folder /mnt/internal/arcade/roms/ps4/<serial>/ (see
# docs/ps4-shadps4.md). shadPS4 has no pad-reachable quit, so this watches the pad evdev node and sends
# SIGTERM, same approach as ryujinx-launch. No arcade-pad-select step: shadPS4 binds pads through SDL, and
# Dark Souls took the pad with no mapping at all (Oct 21).
[ $# -ge 1 ] || { echo "usage: $0 <file.ps4>"; exit 2; }

serial=$(head -n1 "$1" | tr -d "[:space:]")
game="/mnt/internal/arcade/roms/ps4/$serial/eboot.bin"
[ -f "$game" ] || { echo "ps4-launch: no game at $game"; exit 1; }

"$HOME/Applications/shadps4/shadps4.AppImage" -g "$game" -f true &
launcher=$!

python3 - <<'EOF' &
import glob, os, select, signal, struct, subprocess, time

BTN_MODE, EV_KEY = 0x13c, 0x01
HOLD, DOUBLE = 1.0, 0.6            # seconds

def has_guide(ev):
    # capabilities/key is a hex bitmask, most significant word first
    try:
        words = open(f"/sys/class/input/{ev}/device/capabilities/key").read().split()
    except OSError:
        return False
    bits = int("".join(w.zfill(16) for w in words), 16)
    return bool(bits >> BTN_MODE & 1)

def quit_shadps4(why):
    # the AppImage runs the binary from a /tmp/.mount_* path, so match on that
    pids = subprocess.run(["pgrep", "-f", "mount_.*/usr/bin/shadps4 "], capture_output=True, text=True).stdout.split()
    for p in pids:
        os.kill(int(p), signal.SIGTERM)
    print(f"ps4-launch: {why}, sent SIGTERM to {pids}", flush=True)

fds, last_scan = {}, 0.0
down_at, last_tap = None, 0.0
while True:                        # the bash wrapper kills this once shadPS4 exits
    now = time.time()
    if now - last_scan > 2:
        last_scan = now
        present = {os.path.basename(p) for p in glob.glob("/sys/class/input/event*")}
        for fd, ev in list(fds.items()):
            if ev not in present:
                os.close(fd); del fds[fd]
        for ev in present - set(fds.values()):
            if has_guide(ev):
                try:
                    fds[os.open(f"/dev/input/{ev}", os.O_RDONLY | os.O_NONBLOCK)] = ev
                except OSError:
                    pass
    r, _, _ = select.select(list(fds), [], [], 0.1)
    for fd in r:
        while True:
            try:
                data = os.read(fd, 24)
            except (BlockingIOError, OSError):
                break
            if len(data) < 24:
                break
            _, _, etype, code, value = struct.unpack("llHHi", data)
            if etype != EV_KEY or code != BTN_MODE:
                continue
            t = time.time()
            if value == 1:
                down_at = t
                if t - last_tap < DOUBLE:
                    quit_shadps4("Guide double-tap")
                    raise SystemExit
                last_tap = t
            elif value == 0:
                down_at = None
    if down_at and time.time() - down_at >= HOLD:
        quit_shadps4("Guide held")
        raise SystemExit
EOF
watcher=$!

wait $launcher
kill $watcher 2>/dev/null
