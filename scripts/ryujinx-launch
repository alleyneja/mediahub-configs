#!/usr/bin/env bash
# Launch Ryujinx for ES-DE and quit it from the pad: hold the Xbox (Guide) button ~1s, or double-tap it.
# Ryujinx 1.3.3 has no pad-reachable quit (its hotkeys are keyboard-only), and the other emulators here
# quit through a Guide-opened menu, so this watches the pad's evdev node directly and sends SIGTERM,
# which Ryujinx handles as a clean exit (config saved). Hold OR double-tap because some Moonlight clients
# forward Guide as an instant press+release no matter how long it is held.
# Needs: jay in the `input` group (already true for arcade-vpad.py). Pads appear/disappear with the
# Moonlight session, so devices are rescanned every 2s rather than opened once.
[ $# -ge 1 ] || { echo "usage: $0 <rom>"; exit 2; }

"$HOME/.local/bin/arcade-pad-select" ryujinx   # Player 1 -> Sunshine pad or wired pad
flatpak run io.github.ryubing.Ryujinx "$1" &
launcher=$!

python3 - <<'EOF' &
import glob, os, select, signal, struct, subprocess, time

BTN_MODE, EV_KEY = 0x13c, 0x01
HOLD, DOUBLE = 1.0, 0.6            # seconds

def has_guide(ev):
    # capabilities/key is a hex bitmask, most significant word first
    try:
        words = open(f"/sys/class/input/{ev}/device/capabilities/key").read().split()
    except OSError:
        return False
    bits = int("".join(w.zfill(16) for w in words), 16)
    return bool(bits >> BTN_MODE & 1)

def quit_ryujinx(why):
    pids = subprocess.run(["pgrep", "-x", "Ryujinx"], capture_output=True, text=True).stdout.split()
    for p in pids:
        os.kill(int(p), signal.SIGTERM)
    print(f"ryujinx-launch: {why}, sent SIGTERM to {pids}", flush=True)

fds, last_scan = {}, 0.0
down_at, last_tap = None, 0.0
while True:                        # the bash wrapper kills this once Ryujinx exits
    now = time.time()
    if now - last_scan > 2:
        last_scan = now
        present = {os.path.basename(p) for p in glob.glob("/sys/class/input/event*")}
        for fd, ev in list(fds.items()):
            if ev not in present:
                os.close(fd); del fds[fd]
        for ev in present - set(fds.values()):
            if has_guide(ev):
                try:
                    fds[os.open(f"/dev/input/{ev}", os.O_RDONLY | os.O_NONBLOCK)] = ev
                except OSError:
                    pass
    r, _, _ = select.select(list(fds), [], [], 0.1)
    for fd in r:
        while True:
            try:
                data = os.read(fd, 24)
            except (BlockingIOError, OSError):
                break
            if len(data) < 24:
                break
            _, _, etype, code, value = struct.unpack("llHHi", data)
            if etype != EV_KEY or code != BTN_MODE:
                continue
            t = time.time()
            if value == 1:
                down_at = t
                if t - last_tap < DOUBLE:
                    quit_ryujinx("Guide double-tap")
                    raise SystemExit
                last_tap = t
            elif value == 0:
                down_at = None
    if down_at and time.time() - down_at >= HOLD:
        quit_ryujinx("Guide held")
        raise SystemExit
EOF
watcher=$!

wait $launcher
kill $watcher 2>/dev/null
